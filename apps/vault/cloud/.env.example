# 以下为 Sites 环境变量示例，在线上控制台或工具中配置。
VAULT_IMPORT_BYTES=1048576
VAULT_MAX_PAGE_SIZE=48
VAULT_MAX_SELECTION=50
VAULT_FETCH_TIMEOUT_MS=10000
VAULT_SYNC_BATCH_SIZE=3
# 每来源精选文件检查上限，1—100，沿用旧配置名以兼容既有部署。
VAULT_SYNC_MAX_COMMITS=30
VAULT_SYNC_TIMEOUT_MS=90000
VAULT_REGISTRY_HOSTS=ui.shadcn.com,magicui.design,motion-primitives.com,raw.githubusercontent.com
# 生产必须保持 false，本地 Worker 测试可设 true。
VAULT_LOCAL_DEV=false
# MCP 来源读取可选使用服务端 GITHUB_TOKEN Secret。
# Actions 使用运行期临时只读 token，无需将该值保存到这里。
