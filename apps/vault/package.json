{
  "name": "@21st/self-hosted-vault",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "predev": "node scripts/build-parser.mjs",
    "dev": "node --env-file-if-exists=.env server/index.mjs",
    "build": "vite build && node scripts/build-parser.mjs",
    "start": "node --env-file-if-exists=.env server/index.mjs --production",
    "check": "tsc --noEmit",
    "test": "node --test --test-concurrency=1 test/*.test.mjs",
    "build:sites": "node scripts/build-parser.mjs && node scripts/build-sites.mjs"
  },
  "dependencies": {
    "@babel/parser": "7.28.5",
    "@babel/traverse": "7.28.5",
    "@babel/types": "7.28.5",
    "@radix-ui/react-slot": "1.2.3",
    "@tailwindcss/browser": "4.1.17",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "dotenv": "16.6.1",
    "esbuild": "0.25.12",
    "esbuild-wasm": "0.25.12",
    "express": "5.1.0",
    "fflate": "0.8.3",
    "ipaddr.js": "2.2.0",
    "lucide-react": "0.468.0",
    "motion": "12.23.24",
    "postcss": "8.5.32",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "tailwind-merge": "2.6.0",
    "tailwindcss": "3.4.17",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.56.1",
    "@types/react": "19.1.1",
    "@types/react-dom": "19.1.2",
    "@vitejs/plugin-react": "4.7.0",
    "prettier": "3.6.2",
    "typescript": "5.8.3",
    "vite": "6.4.5",
    "wrangler": "4.158.0"
  }
}
