# 首次启动必填，至少 12 个字符。修改后重启，已有会话将失效。
VAULT_PASSWORD=
# 浏览器访问的完整来源，校验登录与写入请求来源。反向代理时填写 HTTPS 域名。
VAULT_ORIGIN=http://localhost:4310
VAULT_HOST=127.0.0.1
VAULT_PORT=4310
VAULT_DATA_DIR=./data
# HTTP 请求与导入解压后的总大小，单位 MiB，范围 1–64。
VAULT_IMPORT_MB=8
# 分页最大条数，范围 12–100。
VAULT_MAX_PAGE_SIZE=48
# 单次选择数量上限，范围 1–100。
VAULT_MAX_SELECTION=50
# 预览编译总超时，单位毫秒，范围 1000–60000。
VAULT_PREVIEW_TIMEOUT_MS=15000
# 同时编译数，范围 1–4；预览缓存条数，范围 1–64。缓存仅保存可重建结果。
VAULT_PREVIEW_CONCURRENCY=2
VAULT_PREVIEW_CACHE_SIZE=24
# 缓存总大小，单位 MiB，范围 1–64；缓存期限，单位秒，范围 30–3600。
VAULT_PREVIEW_CACHE_MB=16
VAULT_PREVIEW_CACHE_TTL_SECONDS=300
# 远程 Registry 读取总超时，单位毫秒，范围 1000–30000。
VAULT_FETCH_TIMEOUT_MS=10000
# 开启后安装示例组件。空库显示“加载示例”按钮，默认不自动添加。
VAULT_SEED_EXAMPLES=false
