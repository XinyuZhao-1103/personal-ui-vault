# 首次启动必填，至少12位，仅用于初始化管理员。之后在账号设置中改密。
VAULT_PASSWORD=
VAULT_ADMIN_USERNAME=admin
# 会话有效期，小时，1–168。
VAULT_SESSION_HOURS=24
# 登录限流窗口，秒，60–3600；单IP及单账号窗口内最多3–30次。
VAULT_LOGIN_WINDOW_SECONDS=300
VAULT_LOGIN_MAX_ATTEMPTS=10
# Workers WebCrypto PBKDF2迭代上限为100000，固定此值。
VAULT_PASSWORD_ITERATIONS=100000
# 每个用户最多1–30个会话。
VAULT_MAX_SESSIONS_PER_USER=10
# 登录日志保留1–365天，最多100–100000行。
VAULT_LOGIN_LOG_RETENTION_DAYS=90
VAULT_LOGIN_LOG_MAX_ROWS=10000
# 限流键最多100–100000条，达到上限时拒绝新的登录尝试。
VAULT_LOGIN_RATE_LIMIT_MAX_KEYS=10000
# 可选，至少32位独立随机密钥，用于IP去标识。留空沿用初始化口令。
# VAULT_AUDIT_HASH_KEY=
# 云端自动维护的独立服务密钥，至少32位。通过Sites secret配置。
# VAULT_SERVICE_TOKEN=
# 云端每来源每轮新增目标，1–10；默认3。已有组件不占名额。
VAULT_SYNC_BATCH_SIZE=3
# 每来源最多扫描的最近提交数，1–100；不足时明确报告。
VAULT_SYNC_MAX_COMMITS=30
# 单轮采集总时限，毫秒，10000–100000。
VAULT_SYNC_TIMEOUT_MS=90000
# Actions 单次最多验证候选数，9–100，通过同名仓库变量配置。
VAULT_SYNC_MAX_ATTEMPTS=60
# 第三方登录预留，尚未启用，详细条件见OAUTH.md。
VAULT_OAUTH_GITHUB_CLIENT_ID=
VAULT_OAUTH_GITHUB_CLIENT_SECRET=
VAULT_OAUTH_GOOGLE_CLIENT_ID=
VAULT_OAUTH_GOOGLE_CLIENT_SECRET=
VAULT_OAUTH_WECHAT_APP_ID=
VAULT_OAUTH_WECHAT_APP_SECRET=
# 浏览器访问的完整来源，校验登录与写入请求来源。反向代理时填写 HTTPS 域名。
VAULT_ORIGIN=http://localhost:4310
VAULT_HOST=127.0.0.1
VAULT_PORT=4310
VAULT_DATA_DIR=./data
# HTTP 请求与导入解压后的总大小，单位 MiB，范围 1–64。
VAULT_IMPORT_MB=8
# 分页最大条数，范围 12–100。
VAULT_MAX_PAGE_SIZE=48
# 单次选择数量上限，范围 1–100。
VAULT_MAX_SELECTION=50
# 预览编译总超时，单位毫秒，范围 1000–60000。
VAULT_PREVIEW_TIMEOUT_MS=15000
# 同时编译数，范围 1–4；预览缓存条数，范围 1–64。缓存仅保存可重建结果。
VAULT_PREVIEW_CONCURRENCY=2
VAULT_PREVIEW_CACHE_SIZE=24
# 缓存总大小，单位 MiB，范围 1–64；缓存期限，单位秒，范围 30–3600。
VAULT_PREVIEW_CACHE_MB=16
VAULT_PREVIEW_CACHE_TTL_SECONDS=300
# 远程 Registry 读取总超时，单位毫秒，范围 1000–30000。
VAULT_FETCH_TIMEOUT_MS=10000
# 开启后安装示例组件。空库显示“加载示例”按钮，默认不自动添加。
VAULT_SEED_EXAMPLES=false
